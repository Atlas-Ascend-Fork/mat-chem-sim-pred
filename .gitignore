# 构建产物（build.sh 就地生成）—— 禁止入库
build/
build_out/
# 注意：算子源码目录 reference/（小写）是正确性基准，必须入库。
# 这里不能使用大小写不敏感的 Reference/ 规则：macOS 默认 core.ignorecase=true，
# 会把 reference/ 一并忽略，导致 reference 静默丢失、无法提交。
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]
*$py.class
PR-error/
# 本地工具/编辑器产物，禁止入库
.DS_Store
.trae/
.trae-html-share-packages/
